{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://gof.zzb.cx/api/:path*"
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
