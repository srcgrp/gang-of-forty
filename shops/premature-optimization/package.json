{
  "name": "premature-optimization",
  "version": "1.0.0",
  "private": "true",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mine": "vite --mode mine",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint src --deny-warnings",
    "check": "tsc --noEmit",
    "ci": "npm run lint --if-present && npm run check && npm run test --if-present -- --run && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "oxlint": "^1.92.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "gsap": "^3.15.0",
    "notyf": "^3.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typecheck": "^0.1.2",
    "zustand": "^5.1.0"
  }
}
